{
  "manifest_version": 3,
  "name": "MilkSU Current Tab Bridge",
  "version": "0.6.1",
  "description": "Connects a user-selected Chrome or Edge tab to local MilkSU. 连接用户选定的标签到本机 MilkSU。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect this tab to MilkSU",
    "default_popup": "popup.html"
  }
}
