    "views": [
      {
        "id": "intake",
        "label": "Intake and scope",
        "focus": ["choose", "pair", "capture", "plan"],
        "note": "The learner chooses a platform problem; MilkSU captures only the paired challenge and establishes an explicit scope."
      },
      {
        "id": "solve",
        "label": "Agent solve cycle",
        "focus": ["plan", "attempt", "tools", "checkpoint", "candidate"],
        "note": "PI iterates inside MilkSU budgets while checkpoints preserve resumable evidence."
      },
      {
        "id": "judge",
        "label": "Judge and learn",
        "focus": ["candidate", "approve", "submit", "receipt", "debrief"],
        "note": "The model proposes; the candidate gate and authoritative platform Judge decide; the result updates learner memory."
      }
    ]
  },
