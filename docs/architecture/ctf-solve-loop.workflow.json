  "cards": [
    {
      "dot": "emerald",
      "title": "Candidate Is Not a Solve",
      "items": [
        "The model writes a candidate, never a completion claim",
        "Mode and policy decide whether learner approval is required",
        "Only the platform Judge receipt updates solved state"
      ]
    },
    {
      "dot": "cyan",
      "title": "Every Run Is Resumable",
      "items": [
        "Attachments, commands, outputs, and hypotheses are checkpointed",
        "Budget or tool errors pause without erasing progress",
        "Resume starts from the last verified checkpoint"
      ]
    },
    {
      "dot": "rose",
      "title": "Training Becomes Memory",
      "items": [
        "Hints and independent steps are recorded separately",
        "Debrief turns evidence into skill deltas and review tasks",
        "Recommendation uses real outcomes, not profile guesses"
      ]
    }
  ]
