      "label": "MilkSU CTF Runtime"
    },
    {
      "id": "agent",
      "label": "PI Agent + Tools"
    },
    {
      "id": "evidence",
      "label": "Evidence + Learning"
    },
    {
      "id": "exceptions",
      "label": "Guardrails + Recovery",
