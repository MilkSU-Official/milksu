  "cards": [
    {
      "dot": "cyan",
      "title": "Product surface",
      "items": [
        "Vue Chromium renderer owns CTF, Coding, CVE, and Settings",
        "Composer + selects reviewed state; selection never sends",
        "No fake desktop data layer when the Preload bridge is absent"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ownership split",
      "items": [
        "Pi owns generic model session, compaction, and tool loop",
        "MilkSU owns authorization, workspace, credentials, and projection"
      ]
    },
    {
      "dot": "rose",
      "title": "Integrity boundaries",
      "items": [
        "Provider keys never enter model context, logs, or ordinary files",
        "Models may propose CTF candidates; only Judge or authorized human marks success"
      ]
    },
    {
      "dot": "amber",
      "title": "Current external slices",
      "items": [
        "In-app Browser uses a conversation-isolated Chromium profile",
        "Browser Use pairs one user-approved real tab",
        "Computer Use binds a user-selected visible App/PID/Window Scope",
        "Security MCPs remain Coding pilots until CTF/CVE admission"
      ]
    }
  ]
