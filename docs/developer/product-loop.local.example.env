# Copy to docs/developer/product-loop.local.env (gitignored) and fill.
# Never paste these values into chat, receipts, commits, or the sibling .md.

# Official TokenFlux personal key. Typed into Settings when needed; never spawned into sidecar.
TOKENFLUX_API_KEY=

# Optional. Direct DeepSeek key if that is the relay you actually use.
DEEPSEEK_API_KEY=

# Custom relay. Official TokenFlux must stay https://tokenflux.dev/v1
CUSTOM_RELAY_BASE_URL=https://tokenflux.dev/v1
# Optional. Empty on official TokenFlux uses catalog deepseek/deepseek-flash.
CUSTOM_RELAY_MODELS=
CUSTOM_RELAY_NAME=product-loop

# After GitHub login: yes if admin assigned TokenFlux quota, no if not.
ACCOUNT_HAS_QUOTA=

# Optional. Read-only OSS checkouts for the companion core loop. Default is ~/code/eval-projects.
# MILKSU_EVAL_PROJECTS=
# Optional. A GitHub repo you own. The core loop must not push click or express upstream.
# MILKSU_EVAL_GITHUB_REPO=
