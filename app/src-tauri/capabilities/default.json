{
  "identifier": "default",
  "description": "Default capabilities for MilkSU",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "allow-send-message",
    "allow-spawn-subagents",
    "allow-get-settings",
    "allow-save-settings-cmd",
    "allow-list-conversations",
    "allow-save-conversation",
    "allow-delete-conversation",
    "allow-create-engagement",
    "allow-get-engagement",
    "allow-update-engagement",
    "allow-list-engagements",
    "allow-delete-engagement",
    "allow-append-timeline-entry",
    "allow-merge-hosts",
    "shell:allow-spawn",
    "shell:allow-stdin-write"
  ]
}
