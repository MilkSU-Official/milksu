{
  "identifier": "default",
  "description": "Default capabilities for MilkSU",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "allow-send-message",
    "allow-get-settings",
    "allow-save-settings-cmd",
    "allow-list-conversations",
    "allow-save-conversation",
    "allow-delete-conversation"
  ]
}
