{
  "name": "@milksu/milksu",
  "version": "26.824.1",
  "description": "MilkSU — one-stop cybersecurity AI learning client",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "postinstall": "patch-package",
    "sidecar:build": "node scripts/package-sidecar.mjs build",
    "sidecar:smoke": "node scripts/package-sidecar.mjs smoke",
    "desktop:build": "node scripts/package-electron.mjs build",
    "desktop:build:stable": "node scripts/package-electron.mjs build --channel=stable",
    "desktop:build:beta": "node scripts/package-electron.mjs build --channel=beta",
    "desktop:release:mac": "node scripts/release-macos.mjs",
    "release:mac:local": "node scripts/release-macos-local.mjs",
    "desktop:release:linux": "node scripts/release-linux.mjs",
    "desktop:release:windows": "node scripts/release-windows.mjs",
    "desktop:start": "node scripts/package-electron.mjs start",
    "desktop:start:beta": "node scripts/package-electron.mjs start:beta",
    "desktop:inspect": "node scripts/package-electron.mjs inspect",
    "desktop:icon:beta": "node scripts/generate-beta-appicon.mjs",
    "codesign:check": "node scripts/check-macos-signing.mjs --app build/bin/MilkSU.app",
    "codesign:check:stable": "node scripts/check-macos-signing.mjs --app build/bin/MilkSU.app --require-stable",
    "test:sidecar": "node --test sidecar/pi/*.test.js sidecar/pi/*.test.cjs sidecar/security/*.test.js sidecar/computer-use/*.test.js browserextension/*.test.js desktop/*.test.cjs",
    "release:verify": "node scripts/verify-release-source.mjs",
    "release:dispatch": "node scripts/dispatch-three-platform-release.mjs",
    "release:collect": "node scripts/collect-three-platform-release.mjs",
    "release:github": "node scripts/publish-github-prerelease.mjs",
    "test:coding-browser": "MILKSU_BROWSER_INTEGRATION=1 go test ./internal/browsercap -run TestManagedBrowserRoundTrip -count=1 -v",
    "test:local-delivery": "node scripts/test-local-delivery-baseline.mjs",
    "test:coding-delivery-report": "node --test tests/scripts/coding-delivery-report.test.mjs",
    "test:ctf-six-track-regression": "node scripts/validate-ctf-six-track-regression.mjs",
    "test:project-mcp": "node scripts/test-project-mcp-fixture.mjs",
    "test:computer-use-live": "node scripts/test-packaged-computer-use-live.mjs",
    "test:windows-computer-use-live": "node scripts/test-windows-computer-use-live.mjs",
    "test:computer-use-agent-vision-live": "node scripts/test-packaged-computer-use-agent-vision-live.mjs",
    "test:github-pr-status-live": "node scripts/test-github-pr-status-live.mjs",
    "test:security-bridge": "printf '%s\\n' '{\"action\":\"protocol_info\",\"requestId\":\"protocol-test\"}' | node sidecar/security/security-bridge.js",
    "spike:pi:protocol": "node spikes/engine-comparison/pi-spike.mjs --protocol-only",
    "spike:pi": "node spikes/engine-comparison/pi-spike.mjs",
    "spike:codex:protocol": "node spikes/engine-comparison/codex-spike.mjs --protocol-only",
    "spike:codex": "node spikes/engine-comparison/codex-spike.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "patch-package": "8.0.1",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@napi-rs/system-ocr": "1.1.0",
    "@narumitw/pi-goal": "0.43.0",
    "@narumitw/pi-lsp": "0.29.0",
    "@playwright/mcp": "0.0.78",
    "@vue/language-server": "2.2.12",
    "diff": "8.0.4",
    "pi-better-background-tasks": "0.1.10",
    "pi-mcp-adapter": "2.17.0",
    "pi-sub-agent": "0.1.5",
    "typebox": "1.1.38",
    "typescript": "6.0.3",
    "typescript-language-server": "5.3.0"
  },
  "overrides": {
    "volar-service-emmet": {
      "@emmetio/css-parser": "0.4.1"
    }
  }
}
