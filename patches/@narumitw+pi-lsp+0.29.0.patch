+
+export function collectWorkspaceEditTargets(
+	edit: WorkspaceEdit | undefined,
+): WorkspaceEditTarget[] {
+	if (!edit) return [];
+	if (edit.documentChanges) {
+		return edit.documentChanges.map((change) => {
+			if (change.textDocument?.uri) {
+				return { kind: "text", uri: change.textDocument.uri };
+			}
+			const resourceChange = change as unknown as {
+				kind?: string;
+				uri?: string;
+				oldUri?: string;
+				newUri?: string;
+			};
+			if (
+				resourceChange.kind === "create"
+				|| resourceChange.kind === "delete"
+			) {
+				return {
+					kind: resourceChange.kind,
+					uri: resourceChange.uri,
+				};
+			}
+			if (resourceChange.kind === "rename") {
+				return {
+					kind: "rename",
+					oldUri: resourceChange.oldUri,
+					newUri: resourceChange.newUri,
+				};
+			}
+			return { kind: "unknown" };
+		});
+	}
+
+	return Object.keys(edit.changes ?? {}).map((uri) => ({ kind: "text", uri }));
+}
+
+export function unsupportedWorkspaceEditTargets(
+	edit: WorkspaceEdit | undefined,
+	currentUri: string,
+) {
+	return collectWorkspaceEditTargets(edit).filter(
+		(target) => target.kind !== "text" || target.uri !== currentUri,
+	);
+}
